<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="screen-orientation" content="landscape" />
  <meta name="theme-color" content="#0a1012" />
  <title>SADU OS — Monitor</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div id="power-off" class="power-off hidden" aria-hidden="true">
    <span>SADU OS</span>
  </div>

  <div id="scroll-banner" class="scroll-banner hidden" aria-live="polite">
    <div class="scroll-track"><span id="scroll-text"></span></div>
  </div>

  <div id="stage" class="stage">
    <header class="topbar">
      <div class="brand-pill">
        <span class="dot"></span>
        <span class="brand-name">SADU OS</span>
      </div>
      <div class="clock-inline">
        <span class="clock-time" id="clockTime">--:--</span>
        <span class="clock-meta" id="city">—</span>
      </div>
      <div class="weather-inline">
        <span class="weather-temp" id="temp">—°</span>
        <span class="cond" id="cond">—</span>
        <span class="wvalue" id="humidity">—</span>
        <span class="wvalue" id="wind">—</span>
      </div>
    </header>

    <section class="panel system" id="block-system">
      <div class="panel-head">
        <span class="widget-title">System</span>
        <span class="meta-ip" id="ipVal">—</span>
      </div>
      <div class="bars-row">
        <div class="bar-row">
          <div class="bar-label-row">
            <span class="bar-label">CPU</span>
            <span class="bar-value" id="cpuVal">0%</span>
          </div>
          <div class="bar-track"><div class="bar-fill cpu" id="cpuBar" style="width:0%"></div></div>
        </div>
        <div class="bar-row">
          <div class="bar-label-row">
            <span class="bar-label">RAM</span>
            <span class="bar-value" id="ramVal">0%</span>
          </div>
          <div class="bar-track"><div class="bar-fill ram" id="ramBar" style="width:0%"></div></div>
        </div>
      </div>
      <div class="sys-meta">
        <div class="meta-item">
          <div class="meta-label">Fan</div>
          <div class="meta-value" id="fanVal">0%</div>
        </div>
        <div class="meta-item temp-ok" id="tempItem">
          <div class="meta-label">Temp</div>
          <div class="meta-value" id="tempVal">0°C</div>
        </div>
      </div>
    </section>

    <section class="panel music idle" id="block-music">
      <div class="music-ambient" id="musicAmbient" aria-hidden="true"></div>
      <div class="music-now">
        <img class="music-cover" id="musicCover" alt="" width="96" height="96" hidden />
        <div class="music-meta">
          <div class="music-title" id="musicTitle">Nothing playing</div>
          <div class="music-sub">
            <span class="music-artist" id="musicArtist">Yandex Music</span>
            <span class="music-time music-playing" id="musicProgress">0:00 / 0:00</span>
          </div>
          <div class="music-track music-playing" aria-hidden="true">
            <div class="music-track-fill" id="musicTrackFill" style="width:0%"></div>
          </div>
          <div class="music-controls music-playing">
            <button type="button" class="music-icon-btn" id="btnStop" data-action="stop" aria-label="Stop">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1.5" fill="currentColor"/></svg>
            </button>
            <button type="button" class="music-icon-btn" id="btnPause" data-action="pause" aria-label="Pause">
              <svg id="iconPause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>
              <svg id="iconPlay" class="hidden" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
            </button>
            <button type="button" class="music-icon-btn" id="btnNext" data-action="next" aria-label="Next">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M6 18l8.5-6L6 6v12zm9-12v12h2V6h-2z"/></svg>
            </button>
          </div>
          <div class="music-controls music-idle-only">
            <button type="button" class="music-wave-btn" id="btnWave" data-action="wave">My Wave</button>
          </div>
        </div>
      </div>
    </section>

    <section class="panel jira" id="block-jira">
      <div class="jira-head">
        <div class="jira-title-block">
          <span class="widget-title" id="jiraTitle">Eng</span>
          <span class="sprint-name" id="sprintName"></span>
        </div>
        <div class="jira-hours">
          <div class="hour-chip">
            <span class="hour-label">Week</span>
            <span class="hour-value" id="jiraWeek">—</span>
          </div>
          <div class="hour-chip">
            <span class="hour-label">Month</span>
            <span class="hour-value" id="jiraMonth">—</span>
          </div>
        </div>
      </div>
      <div class="jira-lists">
        <div class="issue-col todo">
          <div class="issue-col-head">
            <span id="todoLabel">To Do</span>
            <span class="issue-count" id="jiraTodo">0</span>
          </div>
          <ul class="issue-list" id="todoList"></ul>
        </div>
        <div class="issue-col wip">
          <div class="issue-col-head">
            <span id="wipLabel">WIP</span>
            <span class="issue-count" id="jiraWip">0</span>
          </div>
          <ul class="issue-list" id="wipList"></ul>
        </div>
      </div>
    </section>
  </div>

  <video id="keepAwakeVideo" class="keep-awake-video" playsinline muted loop preload="auto" aria-hidden="true">
    <source src="/keepawake.mp4" type="video/mp4" />
  </video>

  <script src="/app.js"></script>
</body>
</html>
