"""Bridge from phone dashboard to standalone /root/music player.

Control plane: accept-all command queue + SSE push. Never returns busy.
"""
from __future__ import annotations

import json
import logging
import queue
import sys
import threading
import time
from pathlib import Path
from typing import Any, Callable

import requests

logger = logging.getLogger(__name__)

MUSIC_ROOT = Path("/root")
COVER_CACHE_DIR = Path("/tmp/yamusic-covers")
METADATA_TTL = 1.5
PROGRESS_TTL = 0.35

if str(MUSIC_ROOT) not in sys.path:
    sys.path.insert(0, str(MUSIC_ROOT))


def _empty_music() -> dict:
    return {
        "ok": False,
        "playing": False,
        "paused": False,
        "buffering": False,
        "switching": False,
        "title": "",
        "artists": "",
        "track_id": "",
        "time_pos": 0,
        "duration": 0,
        "cover_url": "",
        "station": "",
        "volume": 70,
        "lyrics_available": False,
        "lyrics_synced": False,
    }


class MusicBridge:
    def __init__(self) -> None:
        self._player = None
        self._lock = threading.Lock()
        self._cache = _empty_music()
        self._last_meta_refresh = 0.0
        self._last_progress_refresh = 0.0
        self._cover_uri_cache: dict[str, str] = {}
        self._cover_fetch_lock = threading.Lock()
        self._cover_bg_inflight: set[str] = set()
        self._lyrics_cache: dict[str, dict] = {}
        self._lyrics_fetch_lock = threading.Lock()
        self._lyrics_bg_inflight: set[str] = set()

        self._cmd_q: queue.Queue = queue.Queue()
        self._seq = 0
        self._seq_lock = threading.Lock()
        self._volume_pending: int | None = None
        self._volume_event = threading.Event()
        self._subscribers: list[queue.Queue] = []
        self._sub_lock = threading.Lock()
        self._buffering = False
        self._buffering_since = 0.0
        self._switching = False

        threading.Thread(target=self._worker_loop, name="music-cmd-worker", daemon=True).start()
        threading.Thread(target=self._volume_loop, name="music-vol-worker", daemon=True).start()
        threading.Thread(target=self._progress_loop, name="music-progress", daemon=True).start()

    def _get_player(self):
        if self._player is None:
            from music.player import MusicPlayerService

            self._player = MusicPlayerService()
        return self._player

    @staticmethod
    def _cover_url_from_uri(cover_uri: str) -> str:
        from music.yandex_client import YandexMusicController

        return YandexMusicController.cover_uri_to_url(cover_uri, "200x200")

    def _public(self, data: dict | None = None) -> dict:
        src = data if data is not None else self._cache
        out = {k: v for k, v in src.items() if not str(k).startswith("_")}
        out["buffering"] = bool(self._buffering)
        out["switching"] = bool(self._switching)
        return out

    def _next_seq(self) -> int:
        with self._seq_lock:
            self._seq += 1
            return self._seq

    def subscribe(self) -> queue.Queue:
        q: queue.Queue = queue.Queue(maxsize=8)
        with self._sub_lock:
            self._subscribers.append(q)
        q.put(self._public())
        return q

    def unsubscribe(self, q: queue.Queue) -> None:
        with self._sub_lock:
            if q in self._subscribers:
                self._subscribers.remove(q)

    def _publish(self, data: dict | None = None) -> None:
        payload = self._public(data)
        with self._sub_lock:
            subs = list(self._subscribers)
        for q in subs:
            try:
                while q.full():
                    try:
                        q.get_nowait()
                    except queue.Empty:
                        break
                q.put_nowait(payload)
            except Exception:
                pass

    def _commit(self, data: dict) -> dict:
        public = self._public(data)
        with self._lock:
            self._cache = data
            self._last_meta_refresh = time.time()
            self._last_progress_refresh = time.time()
        self._publish(data)
        return public

    def _from_now_playing(self, np: dict) -> dict:
        track_id = str(np.get("track_id") or "")
        cover_uri = (np.get("cover_uri") or "").strip()
        if cover_uri and track_id:
            self._cover_uri_cache[track_id] = cover_uri
        elif track_id and track_id in self._cover_uri_cache:
            cover_uri = self._cover_uri_cache[track_id]

        lyrics_meta = self._lyrics_cache.get(track_id) if track_id else None
        data = _empty_music()
        data.update(
            {
                "ok": bool(np.get("ok")),
                "playing": bool(np.get("playing")),
                "paused": bool(np.get("paused")),
                "buffering": bool(self._buffering or np.get("buffering")),
                "title": np.get("title") or "",
                "artists": np.get("artists") or "",
                "track_id": track_id,
                "time_pos": int(np.get("time_pos") or 0),
                "duration": int(np.get("duration") or 0),
                "station": np.get("station") or "",
                "cover_url": f"/api/music/cover/{track_id}" if track_id and cover_uri else "",
                "volume": int(np.get("volume") if np.get("volume") is not None else 70),
                "lyrics_available": bool(lyrics_meta and lyrics_meta.get("available")),
                "lyrics_synced": bool(lyrics_meta and lyrics_meta.get("synced")),
            }
        )
        if track_id and cover_uri:
            data["_cover_remote"] = self._cover_url_from_uri(cover_uri)
        elif track_id and not cover_uri:
            self._schedule_cover_fetch(track_id)
        if track_id:
            self._schedule_lyrics_fetch(track_id)
        return data

    def _peek_next_track(self) -> dict | None:
        """Optimistic next metadata from state playlist.

        Never raises the global buffering gate — that locks the UI while old audio
        keeps playing. If next is not ready, return None and keep current chrome.
        """
        try:
            player = self._get_player()
            if not player._ipc_alive():
                return None
            state = player._load_state()
            playlist = state.get("playlist") or []
            if len(playlist) < 2:
                return None
            np = player.get_now_playing()
            idx = int(
                np.get("playlist_pos")
                if np.get("playlist_pos") is not None
                else (state.get("current_index") or 0)
            )
            nxt = idx + 1
            if nxt >= len(playlist):
                return None
            item = playlist[nxt]
            track_id = str(item.get("track_id") or "")
            if not track_id:
                return None
            file_path = item.get("file") or ""
            file_ready = False
            if file_path:
                try:
                    p = Path(file_path)
                    file_ready = p.exists() and p.stat().st_size > 32_000
                except Exception:
                    file_ready = False
            if not file_ready:
                # Worker will download; keep current UI instead of Loading lock.
                return None
            cover_uri = item.get("cover_uri") or self._cover_uri_cache.get(track_id) or ""
            data = _empty_music()
            data.update(
                {
                    "ok": True,
                    "playing": True,
                    "paused": False,
                    "buffering": False,
                    "title": item.get("title") or "",
                    "artists": item.get("artists") or "",
                    "track_id": track_id,
                    "time_pos": 0,
                    "duration": int(item.get("duration_sec") or 0),
                    "station": state.get("station") or "",
                    "volume": int(np.get("volume") if np.get("volume") is not None else 70),
                    "cover_url": f"/api/music/cover/{track_id}" if track_id and cover_uri else "",
                }
            )
            if track_id and cover_uri:
                data["_cover_remote"] = self._cover_url_from_uri(cover_uri)
            return data
        except Exception as exc:
            logger.debug("peek next failed: %s", exc)
            return None


    def _schedule_lyrics_fetch(self, track_id: str) -> None:
        track_id = str(track_id or "").strip()
        if not track_id:
            return
        with self._lyrics_fetch_lock:
            if track_id in self._lyrics_cache or track_id in self._lyrics_bg_inflight:
                return
            self._lyrics_bg_inflight.add(track_id)

        def worker() -> None:
            try:
                payload = self._get_player().yandex.fetch_lyrics(track_id)
                with self._lyrics_fetch_lock:
                    self._lyrics_cache[track_id] = payload
                with self._lock:
                    if self._cache.get("track_id") == track_id:
                        self._cache["lyrics_available"] = bool(payload.get("available"))
                        self._cache["lyrics_synced"] = bool(payload.get("synced"))
                        self._publish(self._cache)
            except Exception as exc:
                logger.debug("bg lyrics fetch failed for %s: %s", track_id, exc)
                with self._lyrics_fetch_lock:
                    self._lyrics_cache[track_id] = {
                        "track_id": track_id,
                        "ok": False,
                        "synced": False,
                        "available": False,
                        "lines": [],
                        "text": "",
                    }
            finally:
                with self._lyrics_fetch_lock:
                    self._lyrics_bg_inflight.discard(track_id)

        threading.Thread(target=worker, name=f"lyrics-{track_id}", daemon=True).start()

    def get_lyrics(self, track_id: str) -> dict:
        track_id = str(track_id or "").strip()
        empty = {
            "track_id": track_id,
            "ok": False,
            "synced": False,
            "available": False,
            "lines": [],
            "text": "",
        }
        if not track_id:
            return empty
        with self._lyrics_fetch_lock:
            cached = self._lyrics_cache.get(track_id)
        if cached is not None:
            return dict(cached)
        # Try yandex in-process cache first
        try:
            peeked = self._get_player().yandex.peek_lyrics_cache(track_id)
            if peeked is not None:
                with self._lyrics_fetch_lock:
                    self._lyrics_cache[track_id] = peeked
                return dict(peeked)
        except Exception:
            pass
        try:
            payload = self._get_player().yandex.fetch_lyrics(track_id)
            with self._lyrics_fetch_lock:
                self._lyrics_cache[track_id] = payload
            return dict(payload)
        except Exception as exc:
            logger.debug("get_lyrics failed for %s: %s", track_id, exc)
            return empty

    def _schedule_cover_fetch(self, track_id: str) -> None:
        with self._cover_fetch_lock:
            if track_id in self._cover_uri_cache or track_id in self._cover_bg_inflight:
                return
            self._cover_bg_inflight.add(track_id)

        def worker() -> None:
            try:
                uri = self._get_player().yandex.fetch_cover_uri(track_id) or ""
                if not uri:
                    return
                self._cover_uri_cache[track_id] = uri
                with self._lock:
                    if self._cache.get("track_id") == track_id:
                        self._cache["cover_url"] = f"/api/music/cover/{track_id}"
                        self._cache["_cover_remote"] = self._cover_url_from_uri(uri)
                        self._publish(self._cache)
            except Exception as exc:
                logger.debug("bg cover fetch failed for %s: %s", track_id, exc)
            finally:
                with self._cover_fetch_lock:
                    self._cover_bg_inflight.discard(track_id)

        threading.Thread(target=worker, name=f"cover-{track_id}", daemon=True).start()

    def snapshot(self, *, force: bool = False) -> dict:
        now = time.time()
        with self._lock:
            meta_fresh = (now - self._last_meta_refresh) < METADATA_TTL
            progress_fresh = (now - self._last_progress_refresh) < PROGRESS_TTL
            if not force and meta_fresh and progress_fresh:
                return self._public()
            started_at = now
            need_full = force or not meta_fresh

        try:
            player = self._get_player()
            if self._buffering:
                stuck_for = (time.time() - float(self._buffering_since or 0.0)) if self._buffering_since else 0.0
                np = player.get_now_playing(sync_state=True)
                # Escape hatch: real audio already playing — never hide it behind Loading.
                if np.get("playing") and (np.get("track_id") or np.get("title")):
                    self._buffering = False
                    self._buffering_since = 0.0
                    data = self._from_now_playing(np)
                elif stuck_for > 8:
                    self._buffering = False
                    self._buffering_since = 0.0
                    data = self._from_now_playing(np)
                else:
                    # Wave start only: Starting… placeholder.
                    with self._lock:
                        data = dict(self._cache)
                    data["buffering"] = True
                    data["playing"] = False
                    data["paused"] = False
                    data["title"] = data.get("title") or "Starting…"
                    data["artists"] = data.get("artists") or "Yandex Music"
            elif need_full:
                np = player.get_now_playing(sync_state=True)
                data = self._from_now_playing(np)
                if data.get("playing"):
                    try:
                        player._ensure_watchdog()
                        remaining = int(np.get("playlist_len") or 0) - int(np.get("playlist_pos") or 0)
                        if remaining <= 2:
                            player.request_prefetch()
                    except Exception:
                        pass
            else:
                with self._lock:
                    data = dict(self._cache)
                if data.get("playing") and player._ipc_alive():
                    try:
                        status = player.get_status()
                        data["paused"] = bool(status.get("pause"))
                        data["time_pos"] = int(status.get("time_pos") or 0)
                        data["ok"] = True
                    except Exception:
                        pass
        except Exception as exc:
            logger.debug("music snapshot failed: %s", exc)
            data = _empty_music()
            need_full = True

        public = self._public(data)
        with self._lock:
            if force or started_at >= self._last_meta_refresh:
                self._cache = data
                if need_full or force:
                    self._last_meta_refresh = time.time()
                self._last_progress_refresh = time.time()
                return public
            if not need_full and started_at >= self._last_progress_refresh:
                self._cache["time_pos"] = data.get("time_pos", self._cache.get("time_pos", 0))
                self._cache["paused"] = data.get("paused", self._cache.get("paused", False))
                self._last_progress_refresh = time.time()
            return self._public()

    def _refresh_and_publish(self) -> dict:
        try:
            np = self._get_player().get_now_playing(sync_state=True)
            data = self._from_now_playing(np)
            return self._commit(data)
        except Exception as exc:
            logger.debug("refresh publish failed: %s", exc)
            return self.snapshot(force=True)

    def _worker_loop(self) -> None:
        while True:
            item = self._cmd_q.get()
            try:
                cmd = item.get("cmd")
                player = self._get_player()
                if cmd == "pause":
                    player.toggle_pause()
                elif cmd == "next":
                    try:
                        player.next_track()
                    finally:
                        self._buffering = False
                        self._buffering_since = 0.0
                        self._switching = False
                elif cmd == "stop":
                    self._buffering = False
                    self._buffering_since = 0.0
                    self._switching = False
                    player.stop()
                elif cmd == "wave":
                    self._switching = False
                    self._buffering = True
                    self._buffering_since = time.time()
                    self._publish()
                    try:
                        player.start_my_wave()
                    finally:
                        self._buffering = False
                        self._buffering_since = 0.0
                self._refresh_and_publish()
            except Exception as exc:
                logger.warning("music command %s failed: %s", item.get("cmd"), exc)
                self._buffering = False
                self._buffering_since = 0.0
                self._switching = False
                self._refresh_and_publish()
            finally:
                self._cmd_q.task_done()

    def _volume_loop(self) -> None:
        while True:
            self._volume_event.wait()
            self._volume_event.clear()
            while True:
                with self._lock:
                    pending = self._volume_pending
                    self._volume_pending = None
                if pending is None:
                    break
                try:
                    self._get_player().set_volume(pending)
                    self._refresh_and_publish()
                except Exception as exc:
                    logger.debug("volume set failed: %s", exc)
                time.sleep(0.05)

    def _progress_loop(self) -> None:
        last_sig = None
        while True:
            time.sleep(1.0)
            try:
                if self._buffering:
                    continue
                snap = self.snapshot(force=False)
                sig = (
                    snap.get("track_id"),
                    snap.get("paused"),
                    snap.get("playing"),
                    snap.get("buffering"),
                    snap.get("switching"),
                    int(snap.get("time_pos") or 0) // 2,
                    snap.get("volume"),
                )
                if sig != last_sig:
                    last_sig = sig
                    self._publish()
            except Exception:
                pass

    def _optimistic_pause(self) -> dict:
        with self._lock:
            data = dict(self._cache)
        if data.get("playing"):
            data["paused"] = not bool(data.get("paused"))
            self._commit(data)
        return self._public(data)

    def action(self, cmd: str, *, value=None) -> dict:
        cmd = (cmd or "").strip().lower()
        seq = self._next_seq()

        if cmd in ("volume", "set_volume"):
            try:
                vol = int(round(float(value)))
            except (TypeError, ValueError):
                vol = 70
            vol = max(0, min(100, vol))
            with self._lock:
                self._volume_pending = vol
                data = dict(self._cache)
                data["volume"] = vol
                self._cache = data
            self._volume_event.set()
            self._publish(data)
            return {
                "ok": True,
                "accepted": True,
                "seq": seq,
                "message": f"volume {vol}",
                "music": self._public(data),
            }

        if cmd == "pause":
            music = self._optimistic_pause()
            self._cmd_q.put({"cmd": "pause", "seq": seq})
            return {"ok": True, "accepted": True, "seq": seq, "message": "pause", "music": music}

        if cmd == "next":
            # Never raise self._buffering on next — it locks UI while old track keeps playing.
            # switching=True drives Next-button spinner until worker finishes.
            self._switching = True
            peeked = self._peek_next_track()
            if peeked:
                peeked["switching"] = True
                music = self._commit(peeked)
            else:
                with self._lock:
                    data = dict(self._cache)
                data["switching"] = True
                music = self._commit(data)
            # coalesce: drop older pending nexts
            self._drain_cmd("next")
            self._cmd_q.put({"cmd": "next", "seq": seq})
            return {"ok": True, "accepted": True, "seq": seq, "message": "next", "music": music}

        if cmd == "stop":
            self._switching = False
            empty = _empty_music()
            with self._lock:
                empty["volume"] = self._cache.get("volume", 70)
            music = self._commit(empty)
            self._drain_cmd("stop")
            self._cmd_q.put({"cmd": "stop", "seq": seq})
            return {"ok": True, "accepted": True, "seq": seq, "message": "stop", "music": music}

        if cmd in ("wave", "start"):
            self._buffering = True
            self._buffering_since = time.time()
            pending = _empty_music()
            with self._lock:
                pending["volume"] = self._cache.get("volume", 70)
            pending.update(
                {
                    "ok": True,
                    "playing": False,
                    "paused": False,
                    "buffering": True,
                    "title": "Starting…",
                    "artists": "Yandex Music",
                    "track_id": "",
                    "time_pos": 0,
                    "duration": 0,
                    "cover_url": "",
                    "lyrics_available": False,
                    "lyrics_synced": False,
                }
            )
            music = self._commit(pending)
            self._drain_cmd("wave")
            self._cmd_q.put({"cmd": "wave", "seq": seq})
            return {"ok": True, "accepted": True, "seq": seq, "message": "wave", "music": music}

        return {
            "ok": False,
            "accepted": False,
            "seq": seq,
            "error": f"unknown action: {cmd}",
            "music": self.snapshot(force=True),
        }

    def _drain_cmd(self, cmd: str) -> None:
        kept: list[dict] = []
        try:
            while True:
                item = self._cmd_q.get_nowait()
                if item.get("cmd") != cmd:
                    kept.append(item)
                self._cmd_q.task_done()
        except queue.Empty:
            pass
        for item in kept:
            self._cmd_q.put(item)

    def get_cover_bytes(self, track_id: str) -> tuple[bytes, str] | None:
        track_id = (track_id or "").strip()
        if not track_id or ".." in track_id or "/" in track_id:
            return None

        COVER_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        cached = COVER_CACHE_DIR / f"{track_id.replace(':', '_')}.jpg"
        if cached.exists() and cached.stat().st_size > 500:
            return cached.read_bytes(), "image/jpeg"

        with self._cover_fetch_lock:
            if cached.exists() and cached.stat().st_size > 500:
                return cached.read_bytes(), "image/jpeg"

            remote = ""
            with self._lock:
                if self._cache.get("track_id") == track_id:
                    remote = self._cache.get("_cover_remote") or ""
            if not remote:
                uri = self._cover_uri_cache.get(track_id) or ""
                if not uri:
                    try:
                        np = self._get_player().get_now_playing()
                        if np.get("track_id") == track_id:
                            uri = np.get("cover_uri") or ""
                    except Exception:
                        uri = ""
                if not uri:
                    try:
                        uri = self._get_player().yandex.fetch_cover_uri(track_id) or ""
                    except Exception:
                        uri = ""
                if uri:
                    self._cover_uri_cache[track_id] = uri
                remote = self._cover_url_from_uri(uri)

            if not remote:
                return None

            try:
                r = requests.get(remote, timeout=8)
                if r.status_code != 200 or len(r.content) < 500:
                    return None
                cached.write_bytes(r.content)
                ctype = r.headers.get("Content-Type", "image/jpeg").split(";")[0].strip() or "image/jpeg"
                return r.content, ctype
            except Exception as exc:
                logger.debug("cover download failed: %s", exc)
                return None


music_bridge = MusicBridge()
