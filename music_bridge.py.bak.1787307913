"""Bridge from phone dashboard to gamebot Yandex Music / mpv player."""
from __future__ import annotations

import json
import logging
import os
import sys
import threading
import time
from pathlib import Path

import requests

logger = logging.getLogger(__name__)

BOT_ROOT = Path("/root/bot")
STATE_PATH = Path("/root/bot/music_state.json")
IPC_SOCKET = "/tmp/yamusic_mpv.sock"
COVER_CACHE_DIR = Path("/tmp/yamusic-covers")
MUSIC_REFRESH = 2.0

if str(BOT_ROOT) not in sys.path:
    sys.path.insert(0, str(BOT_ROOT))


def _empty_music() -> dict:
    return {
        "ok": False,
        "playing": False,
        "paused": False,
        "title": "",
        "artists": "",
        "track_id": "",
        "time_pos": 0,
        "duration": 0,
        "cover_url": "",
        "station": "",
    }


class MusicBridge:
    def __init__(self) -> None:
        self._player = None
        self._lock = threading.Lock()
        self._cache = _empty_music()
        self._last_refresh = 0.0
        self._cover_uri_cache: dict[str, str] = {}
        self._cover_fetch_lock = threading.Lock()

    def _get_player(self):
        if self._player is None:
            from music.player import MusicPlayerService

            self._player = MusicPlayerService()
        return self._player

    @staticmethod
    def _cover_url_from_uri(cover_uri: str) -> str:
        from music.yandex_client import YandexMusicController

        return YandexMusicController.cover_uri_to_url(cover_uri, "200x200")

    def _ensure_cover_uri(self, track_id: str, cover_uri: str) -> str:
        if cover_uri:
            self._cover_uri_cache[track_id] = cover_uri
            return cover_uri
        if track_id in self._cover_uri_cache:
            return self._cover_uri_cache[track_id]
        try:
            uri = self._get_player().yandex.fetch_cover_uri(track_id) or ""
            if uri:
                self._cover_uri_cache[track_id] = uri
                self._persist_cover_uri(track_id, uri)
            return uri
        except Exception as exc:
            logger.debug("cover fetch failed for %s: %s", track_id, exc)
            return ""

    def _persist_cover_uri(self, track_id: str, cover_uri: str) -> None:
        try:
            if not STATE_PATH.exists():
                return
            state = json.loads(STATE_PATH.read_text())
            changed = False
            for item in state.get("playlist") or []:
                if item.get("track_id") == track_id and not item.get("cover_uri"):
                    item["cover_uri"] = cover_uri
                    changed = True
            if changed:
                STATE_PATH.write_text(json.dumps(state, ensure_ascii=True, indent=2))
        except Exception:
            pass

    def snapshot(self, *, force: bool = False) -> dict:
        now = time.time()
        with self._lock:
            if not force and now - self._last_refresh < MUSIC_REFRESH:
                return {k: v for k, v in self._cache.items() if not str(k).startswith("_")}
            started_at = now

        data = _empty_music()
        try:
            if not STATE_PATH.exists():
                public = dict(data)
                with self._lock:
                    if force or started_at >= self._last_refresh:
                        self._cache = data
                        self._last_refresh = time.time()
                    return public if force else {
                        k: v for k, v in self._cache.items() if not str(k).startswith("_")
                    }

            state = json.loads(STATE_PATH.read_text())
            playlist = state.get("playlist") or []
            data["station"] = state.get("station") or ""

            if not playlist:
                public = dict(data)
                with self._lock:
                    if force or started_at >= self._last_refresh:
                        self._cache = data
                        self._last_refresh = time.time()
                    return public if force else {
                        k: v for k, v in self._cache.items() if not str(k).startswith("_")
                    }

            index = int(state.get("current_index") or 0)
            paused = False
            time_pos = 0
            alive = os.path.exists(IPC_SOCKET)
            if alive:
                try:
                    status = self._get_player().get_status()
                    index = int(status.get("playlist_pos", index) or 0)
                    paused = bool(status.get("pause"))
                    time_pos = int(status.get("time_pos") or 0)
                    data["ok"] = True
                    data["playing"] = True
                except Exception:
                    alive = False

            index = min(max(index, 0), len(playlist) - 1)
            current = playlist[index]
            track_id = str(current.get("track_id") or "")
            cover_uri = self._ensure_cover_uri(track_id, current.get("cover_uri") or "")

            data.update(
                {
                    "paused": paused,
                    "title": current.get("title") or "",
                    "artists": current.get("artists") or "",
                    "track_id": track_id,
                    "time_pos": time_pos if alive else 0,
                    "duration": int(current.get("duration_sec") or 0),
                    "cover_url": f"/api/music/cover/{track_id}" if track_id and cover_uri else "",
                    "ok": bool(alive or track_id),
                    "playing": bool(alive),
                }
            )
            if track_id and cover_uri:
                data["_cover_remote"] = self._cover_url_from_uri(cover_uri)
        except Exception as exc:
            logger.debug("music snapshot failed: %s", exc)
            data = _empty_music()

        public = {k: v for k, v in data.items() if not str(k).startswith("_")}
        with self._lock:
            # Drop stale concurrent refreshes so an in-flight poll cannot
            # overwrite a fresher force snapshot after next/pause/stop.
            if force or started_at >= self._last_refresh:
                self._cache = data
                self._last_refresh = time.time()
                return public
            return {k: v for k, v in self._cache.items() if not str(k).startswith("_")}

    def action(self, cmd: str) -> dict:
        cmd = (cmd or "").strip().lower()
        player = self._get_player()
        try:
            before = self.snapshot(force=True)
            before_id = before.get("track_id") or ""
            if cmd == "pause":
                message = player.toggle_pause()
            elif cmd == "next":
                message = player.next_track()
            elif cmd == "stop":
                message = player.stop()
            elif cmd in ("wave", "start"):
                message = player.start_my_wave()
            else:
                return {"ok": False, "error": f"unknown action: {cmd}"}
            snap = self.snapshot(force=True)
            # next/wave can race mpv playlist-pos; retry briefly until track changes
            if cmd in ("next", "wave", "start") and before_id:
                for _ in range(5):
                    if (snap.get("track_id") or "") != before_id or not snap.get("playing"):
                        break
                    time.sleep(0.2)
                    snap = self.snapshot(force=True)
            return {"ok": True, "message": message, "music": snap}
        except Exception as exc:
            return {"ok": False, "error": str(exc), "music": self.snapshot(force=True)}

    def get_cover_bytes(self, track_id: str) -> tuple[bytes, str] | None:
        track_id = (track_id or "").strip()
        if not track_id or ".." in track_id or "/" in track_id:
            return None

        COVER_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        cached = COVER_CACHE_DIR / f"{track_id.replace(':', '_')}.jpg"
        if cached.exists() and cached.stat().st_size > 500:
            return cached.read_bytes(), "image/jpeg"

        with self._cover_fetch_lock:
            if cached.exists() and cached.stat().st_size > 500:
                return cached.read_bytes(), "image/jpeg"

            remote = ""
            with self._lock:
                if self._cache.get("track_id") == track_id:
                    remote = self._cache.get("_cover_remote") or ""
            if not remote:
                uri = self._cover_uri_cache.get(track_id) or ""
                if not uri:
                    try:
                        state = json.loads(STATE_PATH.read_text()) if STATE_PATH.exists() else {}
                        for item in state.get("playlist") or []:
                            if item.get("track_id") == track_id:
                                uri = item.get("cover_uri") or ""
                                break
                    except Exception:
                        uri = ""
                if not uri:
                    uri = self._ensure_cover_uri(track_id, "")
                remote = self._cover_url_from_uri(uri)

            if not remote:
                return None

            try:
                r = requests.get(remote, timeout=8)
                if r.status_code != 200 or len(r.content) < 500:
                    return None
                cached.write_bytes(r.content)
                ctype = r.headers.get("Content-Type", "image/jpeg").split(";")[0].strip() or "image/jpeg"
                return r.content, ctype
            except Exception as exc:
                logger.debug("cover download failed: %s", exc)
                return None


music_bridge = MusicBridge()
