# OpenWeatherMap API Key
OWM_API_KEY=your_api_key_here

# Location & Timezone
CITY=Astana
TIMEZONE=Asia/Almaty

# Paths
DB_PATH=/root/bot/bot.db

# Intervals (seconds)
UPDATE_INTERVAL=5
WEATHER_REFRESH=600

# OLED Hardware (optional, if physical SSD1306 still used)
OLED_I2C_PORT=1
OLED_I2C_ADDRESS=0x3C

# Phone web dashboard (replacement for OLED)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Jira Cloud (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_REFRESH=300
# Board mode: count TODO/WIP like the board active sprint (preferred)
JIRA_BOARD_ID=
JIRA_TODO_COLUMN=To Do
JIRA_WIP_COLUMN=В работе
# Fallback when JIRA_BOARD_ID is empty: global status JQL
JIRA_TODO_STATUS=To Do
JIRA_INPROGRESS_STATUS=In Progress
